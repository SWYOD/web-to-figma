{
  "name": "@web-to-figma/desktop",
  "version": "0.1.13",
  "private": true,
  "description": "Desktop-инструмент переноса элементов реальных веб-сайтов в Figma",
  "author": "ilyatrubnikov",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:all": "npm run build && electron-builder --mac --win --publish never"
  },
  "build": {
    "appId": "com.ilyatrubnikov.webtofigma",
    "productName": "Web To Figma",
    "icon": "build/icon.png",
    "artifactName": "Web-To-Figma-${version}-autoupdate-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "SWYOD",
      "repo": "web-to-figma",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Web-To-Figma-${version}-autoupdate-${os}-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Web-To-Figma-${version}-autoupdate-${os}-${arch}-portable.${ext}"
    }
  },
  "dependencies": {
    "@img/sharp-win32-x64": "^0.35.3",
    "@web-to-figma/asset-engine": "workspace:*",
    "@web-to-figma/bridge-protocol": "workspace:*",
    "@web-to-figma/conversion-engine": "workspace:*",
    "@web-to-figma/design-ast": "workspace:*",
    "@web-to-figma/shared": "workspace:*",
    "@web-to-figma/ui": "workspace:*",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.462.0",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
